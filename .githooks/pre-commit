#!/usr/bin/env sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
LAST_REVIEW_SCRIPT="$ROOT_DIR/scripts/update-last-reviewed-for-staged.ps1"
REPO_MAP_SCRIPT="$ROOT_DIR/scripts/verify-repo-map-status.ps1"

if [ ! -f "$LAST_REVIEW_SCRIPT" ]; then
  echo "Missing script: $LAST_REVIEW_SCRIPT"
  exit 1
fi

if [ ! -f "$REPO_MAP_SCRIPT" ]; then
  echo "Missing script: $REPO_MAP_SCRIPT"
  exit 1
fi

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "Neither 'pwsh' nor 'powershell' is available."
  exit 1
fi

"$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$LAST_REVIEW_SCRIPT"
"$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$REPO_MAP_SCRIPT" -Root "$ROOT_DIR" -RepoMapPath "docs/indexes/repo-map.md" -Regenerate -OnlyChangedDocs -Stage
